{
  "manifest_version": 3,
  "name": "Session Exporter for Claude Code",
  "short_name": "Code Exporter",
  "version": "1.0.0",
  "description": "Save Claude Code session history as Markdown, including tool calls and results.",
  "author": "Boden Crouch",
  "homepage_url": "https://github.com/bodencrouch/claude-code-exporter",
  "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"},
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Export Claude Code",
    "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png"}
  }
}
